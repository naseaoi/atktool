{
  "name": "atktool",
  "version": "1.1.0",
  "description": "ATK / VXE 鼠标电量悬浮窗",
  "scripts": {
    "start": "node scripts/run-rust-tool.js tauri dev",
    "assets:icons": "node scripts/generate-app-icon.js && node scripts/run-rust-tool.js tauri icon assets/app-icon.png --output src-tauri/icons",
    "tauri:dev": "node scripts/run-rust-tool.js tauri dev",
    "tauri:build": "node scripts/run-rust-tool.js tauri build",
    "docs:screenshots": "node scripts/capture-screenshots.js",
    "test": "node --test && node scripts/run-rust-tool.js cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "npm run check:syntax && npm test",
    "audit:runtime": "npm audit --omit=dev --registry=https://registry.npmjs.org/",
    "build:win": "node scripts/build-windows.js bundle",
    "build:win:unpacked": "node scripts/build-windows.js unpacked"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "license": "ISC",
  "type": "commonjs"
}
